# Generate a strong random key: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-use-a-long-random-string

# First-run admin credentials (change immediately after first login)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin

# Token lifetimes
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=60

# Storage. Leave unset for SQLite on the /data volume.
# DATABASE_URL=postgresql://libation:libation@postgres:5432/libation

# Single sign-on. All four are required before SSO is considered configured —
# until then password login stays on, so a typo cannot lock you out.
# OIDC_ENABLED=true
# OIDC_ISSUER=https://auth.example.com
# OIDC_CLIENT_ID=libation-web
# OIDC_CLIENT_SECRET=
# Normally derived from the request (X-Forwarded-Proto/-Host are honoured, so
# this is right behind a reverse proxy). Set it only if your proxy sends no
# X-Forwarded-* headers; it must then match what you registered exactly.
# OIDC_REDIRECT_URL=https://libation.example.com/api/auth/oidc/callback
# OIDC_PROVIDER_NAME=SSO
# OIDC_ADMIN_GROUP=libation-admins
# OIDC_AUTO_CREATE_USERS=true

# Password sign-in turns off by itself once SSO is configured.
# Set this to keep it available — also the way back in if SSO breaks.
# ALLOW_PASSWORD_LOGIN=true

# Which source addresses may set X-Forwarded-* headers. The default trusts any,
# which is right for a container reachable only through your reverse proxy.
# Narrow it if port 8000 is exposed more widely than that.
# FORWARDED_ALLOW_IPS=*
